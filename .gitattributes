# Normalize line endings to LF on checkin; check out with LF everywhere.
# Prevents CRLF/LF churn on Windows contributors.
* text=auto eol=lf

# ─────────────────────────────────────────────
# Source — force LF
# ─────────────────────────────────────────────
*.rs        text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.txt       text eol=lf
*.lock      text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf
Dockerfile        text eol=lf
Makefile          text eol=lf

# ─────────────────────────────────────────────
# Binary — never normalize, never diff as text
# ─────────────────────────────────────────────
*.parquet   binary
*.avro      binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.bin       binary
*.so        binary
*.dylib     binary
*.dll       binary

# ─────────────────────────────────────────────
# Linguist / GitHub display hints
# ─────────────────────────────────────────────
*.md         linguist-documentation
tests/fixtures/**  linguist-vendored

# ─────────────────────────────────────────────
# Export-ignore — exclude from `git archive` tarballs
# ─────────────────────────────────────────────
.gitignore        export-ignore
.gitattributes    export-ignore
.github/          export-ignore
tests/fixtures/   export-ignore
